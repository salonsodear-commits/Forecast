// ============================================================================
//  MEDIDAS DAX a agregar  (Modelo -> clic derecho en 'Resumen Base' -> Nueva medida)
//
//  NOTA: la medida base [Ventas] = SUM('Resumen Base'[Valor]) YA EXISTE.
//        No la recrees. Estas medidas se apoyan en ella y en la nueva columna
//        'Resumen Base'[TipoDato] (Real / Proyectado).
// ============================================================================

Ventas Real =
CALCULATE ( [Ventas], 'Resumen Base'[TipoDato] = "Real" )

Ventas Proyectado =
CALCULATE ( [Ventas], 'Resumen Base'[TipoDato] = "Proyectado" )

// Vista combinada: Real hasta el cierre + Proyectado después (la tabla ya une ambos).
Ventas Forecast = [Ventas]

// KPI de control: último mes con dato REAL vigente (debería dar 01/04/2026 hoy).
Último Cierre =
CALCULATE ( MAX ( 'Resumen Base'[Fecha] ), 'Resumen Base'[TipoDato] = "Real" )

// ---------------------------------------------------------------------------
//  OPCIONALES (control del mix 4+8 del año en curso). Requieren la relación
//  Calendario[Date] 1:* 'Resumen Base'[Fecha].
// ---------------------------------------------------------------------------
Meses Reales =
CALCULATE ( DISTINCTCOUNT ( 'Resumen Base'[Fecha] ), 'Resumen Base'[TipoDato] = "Real" )

Meses Proyectados =
CALCULATE ( DISTINCTCOUNT ( 'Resumen Base'[Fecha] ), 'Resumen Base'[TipoDato] = "Proyectado" )
